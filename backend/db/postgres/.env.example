# Copie para .env.supabase (ignorado pelo git) e preencha. Valores com # precisam de aspas.

# DONO do banco (usuário postgres.<ref-do-projeto>): Supabase > Connect > Session pooler (funciona em IPv4).
# Sem ?sslmode= na URL.
DATABASE_URL=

# Certificado da CA do Supabase (Settings > Database > SSL Configuration) para verificar o TLS.
DATABASE_SSL_CA_PATH=

# Papel que o backend vai usar (só leitura/escrita nas tabelas, sem DDL). Senha longa e aleatória (24+ caracteres).
APP_DB_USER=estoque_app
APP_DB_PASSWORD=

# Primeiro administrador do sistema (create-admin.mjs).
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Só para migrate-data.mjs: banco MySQL de onde os dados vêm.
MYSQL_URL=
